{
  "name": "afsim-dev-tool",
  "displayName": "AFSIM Dev Tool",
  "description": "AFSIM development support: syntax highlighting, auto-completion, go to definition, hover",
  "version": "0.1.0",
  "publisher": "afsim-dev",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:afsim"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "afsim",
        "aliases": [
          "AFSIM",
          "afsim"
        ],
        "extensions": [
          ".txt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "afsim_logo.png",
          "dark": "afsim_logo.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "afsim",
        "scopeName": "source.afsim",
        "path": "./syntaxes/afsim.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "AFSIM Dev Tool",
      "properties": {
        "afsim.scriptCompletionDelay": {
          "type": "number",
          "default": 500,
          "description": "Delay in ms before updating dynamic script completions after editing stops"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.118.0",
    "typescript": "^5.3.0"
  }
}
